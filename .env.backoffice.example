APP_NAME=backoffice-api
APP_ENV=production
APP_LOG_LEVEL=info
DB_URL=postgresql+psycopg://user:pass@db.example.com:5432/appdb
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
AUTH_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
AUTH_GOOGLE_CLIENT_SECRET=yyyy
AUTH_GOOGLE_REDIRECT_URI=https://api.example.com/auth/google/callback
AUTH_TOKEN_ENC_KEY=base64-32-bytes-or-strong-key
ALEMBIC_MODEL_MODULES=common.db.models,backoffice_api.db.models
